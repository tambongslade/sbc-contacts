// SBC Contacts — Prisma schema
// This backend is an SSO CLIENT of SBC. It does NOT own the member base.
// The `Member` table is a MIRROR/CACHE of SBC members: hydrated cache-through
// from proxied per-member searches today, and ready for webhook/bulk import
// the moment SBC exposes those channels. Everything else is app-owned data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  Identity & sessions
// ─────────────────────────────────────────────────────────────

/// A user of SBC Contacts, identified 1:1 with an SBC account. We never
/// create an independent credential (cahier §4) — auth is delegated to SBC SSO.
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  sbcUserId String   @unique // SBC's user id (source of truth for identity)
  role      Role     @default(USER)

  // Cached profile snapshot from /api/sso/userinfo (refreshed on login).
  name              String?
  email             String?
  phoneNumber       String?
  country           String?
  avatarUrl         String?
  subscriptionTypes String[] @default([])
  isActivated       Boolean  @default(false)

  /// bcrypt hash for the optional email+password login used by the admin
  /// back-office (SSO stays the default). Null = this account is SSO-only.
  passwordHash String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete

  sbcToken       SbcToken?
  sessions       AppSession[]
  criteria       SyncCriteria[]
  favorites      Favorite[]
  syncRuns       SyncRun[]
  syncedContacts SyncedContact[]
  notifications  Notification[]
  devices        Device[]
  addedByMe      AddedEvent[]    @relation("actor")
  reviews        MemberReview[]
  proProfile      ProProfile?
  serviceRequests ServiceRequest[]

  @@index([deletedAt])
  @@map("users")
}

/// SBC access/refresh tokens, ENCRYPTED at rest (AES-256-GCM).
/// One current pair per user; rotated on every /sso/refresh (rolling refresh).
model SbcToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessTokenEnc   String // ciphertext
  refreshTokenEnc  String // ciphertext
  scope            String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sbc_tokens")
}

/// Our OWN app session for the Flutter client: a refresh-token family with
/// rotation + reuse detection. Access tokens are stateless JWTs (not stored).
model AppSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String    @unique // sha-256 of the issued refresh token
  familyId         String    @db.Uuid // rotation family; reuse of a rotated token revokes the family
  deviceId         String?
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?   @db.Uuid

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("app_sessions")
}

// ─────────────────────────────────────────────────────────────
//  SBC member mirror (cache)
// ─────────────────────────────────────────────────────────────

enum MemberSource {
  SEARCH_CACHE // hydrated opportunistically from a proxied search
  WEBHOOK // pushed by SBC (future)
  BULK_IMPORT // batch import (future)
}

/// Denormalised, best-effort copy of SBC member fields the directory shows.
/// Authoritative data always lives in SBC; this is a queryable cache and the
/// substrate for criteria-matching. TTL/`staleAfter` governs re-fetch.
model Member {
  id        String @id @default(uuid()) @db.Uuid
  sbcId     String @unique // SBC member id

  name        String?
  firstName   String?
  profession  String?
  city        String?
  country     String?
  sex         String?
  age         Int?
  interests   String[] @default([])
  skills      String[] @default([])
  avatarUrl   String?
  phoneNumber String?

  source      MemberSource @default(SEARCH_CACHE)
  lastSeenAt  DateTime     @default(now()) // last time SBC confirmed this record
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  favoritedBy    Favorite[]
  syncedContacts SyncedContact[]

  @@index([country, city])
  @@index([profession])
  @@index([sex, age])
  @@map("members")
}

// ─────────────────────────────────────────────────────────────
//  Saved sync criteria & sync operations
// ─────────────────────────────────────────────────────────────

/// A named set of matching criteria (cahier §10). The matching worker
/// re-evaluates active criteria and raises NEW_MATCH notifications.
model SyncCriteria {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label       String
  countries   String[] @default([])
  cities      String[] @default([])
  professions String[] @default([])
  interests   String[] @default([])
  sex         String?
  ageMin      Int?
  ageMax      Int?

  isActive        Boolean   @default(true)
  lastCheckedAt   DateTime?
  lastResultHash  String? // fingerprint of the last match set, for cheap diffing
  lastMatchCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@map("sync_criteria")
}

enum SyncRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  ABANDONED // started, never reported — the client backed out or was killed
}

/// One synchronisation operation, for the history view (cahier §17).
model SyncRun {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  criteriaId  String?       @db.Uuid
  deviceId    String?
  status      SyncRunStatus @default(PENDING)
  matchCount  Int           @default(0)
  syncedCount Int           @default(0)
  failedCount Int           @default(0)
  error       String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([userId, startedAt])
  @@map("sync_runs")
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  STALE // SBC data changed since last write to the device
}

/// Tracks which SBC members a user has written to which device, powering
/// dedup (cahier §15), "Mes contacts SBC" (§16) and identification (§14).
model SyncedContact {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  memberId String @db.Uuid
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  deviceId        String?
  deviceContactId String? // native contact id returned by the phone
  status          SyncStatus @default(PENDING)
  syncedAt        DateTime?

  /// The run that intends to write this contact, while it is still PENDING.
  /// Cleared once the device reports an outcome. Without it a PENDING row
  /// outlived the run that created it, so every abandoned run left its targets
  /// queued forever and "en attente" counted runs nobody ever finished.
  syncRunId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, memberId, deviceId])
  @@index([userId, status])
  @@index([syncRunId])
  @@map("synced_contacts")
}

// ─────────────────────────────────────────────────────────────
//  Favorites, notifications, events, audit
// ─────────────────────────────────────────────────────────────

/// Cahier §18.
model Favorite {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  memberId String @db.Uuid
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, memberId])
  @@index([userId])
  @@map("favorites")
}

// ─────────────────────────────────────────────────────────────
//  Confidence score & reviews ("Score de confiance")
// ─────────────────────────────────────────────────────────────

/// One editable review per (reviewer, member). Keyed by the DURABLE SBC id of
/// the member being rated — NOT the local mirror uuid, which is regenerated
/// whenever the member cache row is evicted/re-created. This lets reviews and
/// the resulting confidence score outlive cache churn.
model MemberReview {
  id             String @id @default(uuid()) @db.Uuid
  reviewerUserId String @db.Uuid
  reviewer       User   @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)

  memberSbcId String // SBC id of the member being reviewed
  stars       Int // 1..5
  comment     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reviewerUserId, memberSbcId])
  @@index([memberSbcId])
  @@map("member_reviews")
}

/// Pre-aggregated reputation per member, recomputed transactionally on every
/// review write so directory search/profile annotation stays a single cheap
/// lookup (no per-row AVG). The confidence score (0-100, neutral 50) is derived
/// from `averageStars` in the app layer — see ReviewsService.confidenceScore().
model MemberScore {
  memberSbcId  String   @id
  averageStars Float    @default(0)
  reviewCount  Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("member_scores")
}

enum NotificationType {
  NEW_MATCH // a new member matches a saved criteria (§11)
  NEW_CORRESPONDENCE // new correspondences available (§19)
  SYNC_AVAILABLE // pending contacts ready to sync
  SYNC_ERROR // a sync failed
  CONTACT_SAVED // someone saved you to their phone (§21)
  REQUEST_RECEIVED // SBC Data: a request matching your services (Data §9)
  REQUEST_RESPONSE // SBC Data: a pro answered your request (Data §11)
  REQUEST_SELECTED // SBC Data: the requester chose you (Data §12)
  REQUEST_CLOSED // SBC Data: a request you answered is no longer open (Data §12)
  REQUEST_NO_RESPONSE // SBC Data: nobody answered the requester's demand in time
}

/// In-app notification store (cahier §19). Push/SMS/email are dispatched via
/// the notifications abstraction on top of these rows.
model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  body    String
  data    Json?
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

/// "Qui m'a ajouté ?" — only recorded when technically confirmable (cahier §21).
model AddedEvent {
  id      String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  actor   User   @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)

  targetMemberSbcId String
  confirmedAt       DateTime @default(now())

  @@index([targetMemberSbcId])
  @@map("added_events")
}

/// Reusable audit trail for sensitive business actions (brief §11).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String // e.g. "criteria.update", "sync.run"
  resource   String // e.g. "SyncCriteria:<id>"
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Platform {
  ANDROID
  IOS
}

/// Push registration for notifications.
model Device {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform  Platform
  pushToken String?
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, pushToken])
  @@map("devices")
}

/// Idempotency + audit for inbound SBC webhooks (cahier §11 / brief §20).
/// Ready now; consumed once SBC emits new/updated-member events.
model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  externalId  String   @unique // provider event id — dedup key for idempotency
  type        String
  payload     Json
  signature   String?
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────
//  SBC Data — requests routed to professionals ("cahier SBC Data")
//  The requester describes a need; the AI structures it; matching picks the
//  pros whose services fit; they answer; the requester chooses.
// ─────────────────────────────────────────────────────────────

/// How a service is delivered (Data §3, §4). Shared by profiles, services and
/// requests so matching compares like with like.
enum ServiceMode {
  HOME // à domicile
  ON_SITE // dans l'établissement du pro
  ONLINE // en ligne
  DELIVERY // livraison
}

/// What a pro adds on top of the SBC profile we already hold (Data §3). Name,
/// photo, WhatsApp, country come from `User`; nothing is asked twice (Data §2).
model ProProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profession   String
  description  String
  city         String
  /// Neighbourhoods / towns served besides `city`.
  zones        String[]      @default([])
  modes        ServiceMode[] @default([])
  availability String // free text for now ("lun-sam 8h-18h", "sur rendez-vous")
  priceMin     Int?
  priceMax     Int?
  shopUrl      String
  /// Defaults to the SBC phone number; a pro may route requests elsewhere.
  whatsapp     String?

  /// Receiving requests is the paid part (Data §17: 2 000 FCFA/mois). Until
  /// payments exist an admin switches it on; `receivingUntil` null = no expiry.
  receivingEnabled Boolean   @default(false)
  receivingUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services   ProService[]
  dispatches RequestDispatch[]

  @@index([receivingEnabled])
  @@map("pro_profiles")
}

/// One service a pro offers, as structured by the AI and validated by the pro
/// (Data §4, §5). `synonyms` feed search and are never shown to the pro.
model ProService {
  id    String     @id @default(uuid()) @db.Uuid
  proId String     @db.Uuid
  pro   ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)

  name        String // "Réparation de locks"
  category    String // "Locks" — groups a pro's sub-services
  profession  String // "Coiffeur"
  synonyms    String[]      @default([])
  specialties String[]      @default([])
  description String?
  priceMin    Int?
  priceMax    Int?
  modes       ServiceMode[] @default([]) // empty = the profile's modes
  zones       String[]      @default([]) // empty = the profile's zones
  delay       String?
  isActive    Boolean       @default(true)

  /// Gemini embedding of name + category + profession + synonyms, for the
  /// semantic half of matching. Empty until computed.
  embedding Float[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispatches RequestDispatch[]

  @@index([proId, isActive])
  @@map("pro_services")
}

/// Data §16.
enum RequestStatus {
  DRAFT // analysed, waiting for the requester to confirm
  MATCHING // confirmed, matching in progress
  SENT // routed to at least one pro
  RESPONDED // at least one pro is interested
  LOCKED // the cap of interested answers was reached; no more are taken (Data §C)
  SELECTED // a pro was chosen
  COMPLETED
  CANCELLED
  NO_MATCH // no pro fits
  NO_RESPONSE // routed, but nobody answered in time
}

/// A need described in free text (Data §6, §7).
model ServiceRequest {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rawText String
  status  RequestStatus @default(DRAFT)

  /// Interested answers received so far (Data §C). Capped at MAX_RESPONSES;
  /// the request auto-locks and stops taking answers once the cap is hit.
  /// Bumped with an atomic, guarded UPDATE so the cap holds under concurrency.
  responseCount Int @default(0)

  // The AI's structured reading (Data §7), editable by the requester before
  // sending. Kept as columns because matching filters on them.
  profession  String?
  service     String?
  specialties String[]     @default([])
  city        String?
  district    String?
  mode        ServiceMode?
  desiredDate String? // as understood ("samedi", "15/10")
  desiredTime String?
  budget      Int? // FCFA
  constraints String[]     @default([])

  /// A short question the AI asks when the need is ambiguous (Data §7).
  clarificationQuestion String?
  clarificationOptions  String[] @default([])
  clarificationAnswer   String?

  embedding Float[] @default([])

  selectedDispatchId String?   @db.Uuid
  sentAt             DateTime?
  completedAt        DateTime?
  /// Requester's word on the job (Data §15): false = reported as not done.
  wasPerformed       Boolean?
  /// The requester deleted it from "Mes demandes". Hidden, not erased: the
  /// pros who answered keep it in their history and statistics.
  hiddenAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispatches RequestDispatch[]

  @@index([userId, status])
  @@map("service_requests")
}

/// Data §10.
enum DispatchStatus {
  SENT
  VIEWED
  INTERESTED
  QUESTION
  UNAVAILABLE
  DECLINED
  SELECTED
  LOST // another pro was chosen, or the request closed
}

/// A request routed to one pro, the pro's answer, and why they were picked.
model RequestDispatch {
  id        String         @id @default(uuid()) @db.Uuid
  requestId String         @db.Uuid
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proId     String         @db.Uuid
  pro       ProProfile     @relation(fields: [proId], references: [id], onDelete: Cascade)
  serviceId String?        @db.Uuid
  service   ProService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  /// Internal ranking score (Data §8) — never shown to the requester.
  score   Float
  /// Why this pro was selected, for the back-office matching logs (Data §21).
  reasons Json?

  status DispatchStatus @default(SENT)

  // The pro's proposal (Data §10).
  price        Int?
  availability String?
  delay        String?
  message      String?

  viewedAt    DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([requestId, proId])
  @@index([proId, status])
  @@map("request_dispatches")
}

/// Predictive market analytics (Data §E, the "Google Trends" feature). Every
/// matching run logs one lightweight event: what was sought and how many pros
/// it reached. `matchedVendorCount == 0` (fulfilled = false) is an unfulfilled
/// demand — the admin report groups these to surface market gaps to recruit for.
/// No FK on `userId` so an event survives member-cache churn like reviews do.
model SearchAnalytics {
  id String @id @default(uuid()) @db.Uuid

  userId    String? @db.Uuid
  requestId String? @db.Uuid

  /// The need as a search term (the AI `service`, else `profession`, else raw).
  term       String
  profession String?
  city       String?
  mode       ServiceMode?

  matchedVendorCount Int
  /// matchedVendorCount > 0 — denormalised so the gap report is a cheap filter.
  fulfilled          Boolean

  createdAt DateTime @default(now())

  @@index([fulfilled, createdAt])
  @@index([term])
  @@map("search_analytics")
}
